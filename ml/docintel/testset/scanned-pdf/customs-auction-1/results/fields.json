  "key_points": [
    "यो कार्यालयमा विभिन्न सामानहरू लिलाममा बिक्री गरिने व्यहोरा जानकारी दिइएको छ।",
    "लिलामको मिति २०८३ साल मंसिर १ गते बुधवार हो।",
    "लिलामको समय बिहान ११:०० बजेदेखि दिउँसो १:०० बजेसम्म रहनेछ।",
    "लिलाममा बिक्री हुने वस्तुहरूको सूची र न्यूनतम मूल्य तालिकामा दिइएको छ।",
    "लिलाममा सहभागी हुन इच्छुक व्यक्तिहरूले आवश्यक कागजात पेश गर्नुपर्नेछ।"
  ],
