  "key_points": [
    "जफत भएका वस्तुहरूको लिलाम बिक्री गर्ने १५ दिने सूचना हो।",
    "लिलाम खुला बोलकबोल द्वारा डांक बढाबढ गरी गरिनेछ।",
    "लिलाम स्वीकार गर्दा कुल रकमको १० प्रतिशत धरौटी अनिवार्य राख्नुपर्नेछ।",
    "लिलाम हुने मिति २०८३ साल मंसिर महिना २ गते बुधबार हो।",
    "लिलाम हुने स्थान सिराहा भन्सार कार्यालय, माडर हो।"
