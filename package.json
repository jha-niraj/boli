{
	"name": "basecode",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"check-types": "turbo run check-types",
		"db:push": "pnpm --filter @repo/db db:push",
		"db:studio": "pnpm --filter @repo/db db:studio",
		"db:seed": "pnpm --filter @repo/db db:seed",
		"deploy:staging": "tsx scripts/deploy.mts staging",
		"deploy:prod": "tsx scripts/deploy.mts prod",
		"env:check": "tsx scripts/env-check.mts",
		"env:set": "tsx scripts/env-set.mts",
		"env:restore": "tsx scripts/env-restore.mts"
	},
	"devDependencies": {
		"prettier": "^3.7.4",
		"tsx": "^4.23.15",
		"turbo": "^2.11.13",
		"typescript": "5.9.3"
	},
	"pnpm": {
		"overrides": {
			"react": "19.3.1",
			"react-dom": "19.3.1",
			"@radix-ui/react-slot@<1.2.4": "1.2.4",
			"zod@^4": "4.6.7",
			"recharts": "3.11.0"
		},
		"patchedDependencies": {
			"next@16.4.6": "patches/next@16.4.6.patch"
		}
	},
	"packageManager": "pnpm@9.0.0",
	"engines": {
		"node": ">=20"
	}
}
