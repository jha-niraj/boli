{
	"$schema": "node_modules/wrangler/config-schema.json",
	/*
	 * TOP LEVEL = STAGING, so a bare `wrangler deploy` can never reach the live app. Production is `env.prod`.
	 * Deploy only with `pnpm deploy:staging admin` / `pnpm deploy:prod admin` (a person runs these).
	 * Bindings do NOT inherit into env.prod: a new binding goes in both places.
	 *
	 * account_id: pin it. Without one wrangler deploys to whichever account this machine is logged in to
	 * (scripts/deploy.mts refuses to deploy until it is a real 32-hex id).
	 */
	"account_id": "__CLOUDFLARE_ACCOUNT_ID__",
	"name": "basecode-admin-staging",
	"main": "worker.ts",
	// "routes": [{ "pattern": "admin-staging.example.com", "custom_domain": true }],
	/*
	 * minify: without it wrangler re-prints OpenNext's built handler unminified and the upload outgrows the Workers
	 * 64 MiB limit. keep_names false: with wrangler's default esbuild wraps functions in a __name helper, next-themes
	 * inlines its theme script, the helper does not come along, and every page throws "e is not defined" before paint.
	 */
	"minify": true,
	"keep_names": false,
	"compatibility_date": "2025-11-01",
	// nodejs_compat is required by better-auth, the Neon driver and the AI SDK. Never remove it.
	"compatibility_flags": ["nodejs_compat"],
	// Run next to the database (set to your Neon region), not next to the visitor: a page makes several queries.
	"placement": { "region": "aws:ap-southeast-1" },
	"assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
	// JOBS: the boli-jobs Worker (apps/jobs) - Workflows for long jobs and the RateLimiter Durable Object, called as RPC
	// only when JOBS_RUNNER=workflow (packages/jobs). Deploy boli-jobs first: a binding to a Worker that does not exist
	// yet fails the deploy.
	"services": [
		{ "binding": "WORKER_SELF_REFERENCE", "service": "basecode-admin-staging" },
		{ "binding": "JOBS", "service": "boli-jobs-staging" }
	],
	"r2_buckets": [
		{ "bucket_name": "basecode-files", "binding": "FILES", "remote": true },
		{ "bucket_name": "basecode-next-cache", "binding": "NEXT_INC_CACHE_R2_BUCKET" }
	],
	// Staging runs no crons: a staging job would email real people or charge real cards.
	"triggers": { "crons": [] },
	"observability": { "enabled": true, "head_sampling_rate": 1 },
	"env": {
		"prod": {
			"name": "basecode-admin",
			// "routes": [{ "pattern": "admin.example.com", "custom_domain": true }],
			"services": [
				{ "binding": "WORKER_SELF_REFERENCE", "service": "basecode-admin" },
				{ "binding": "JOBS", "service": "boli-jobs" }
			],
			"r2_buckets": [
				{ "bucket_name": "basecode-files-prod", "binding": "FILES", "remote": true },
				{ "bucket_name": "basecode-next-cache-prod", "binding": "NEXT_INC_CACHE_R2_BUCKET" }
			],
			"triggers": { "crons": [] }
		}
	}
}
