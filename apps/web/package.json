{
    "name": "web",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "description": "The public site (bolihq.com): landing, About, Contact, Docs, Blog, Guides, Changelog, Models, Terms, Privacy, /design (dev only)",
    "scripts": {
        "content": "node --import tsx scripts/build-content.ts",
        "dev": "node --import tsx scripts/build-content.ts && next dev --webpack --port 3102",
        "build": "node --import tsx scripts/build-content.ts && next build --webpack",
        "start": "next start --port 3102",
        "lint": "eslint --max-warnings 0",
        "check-types": "next typegen && tsc --noEmit",
        "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
        "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
    },
    "dependencies": {
        "@fontsource-variable/fraunces": "^5.3.0",
        "@fontsource-variable/instrument-sans": "^5.3.0",
        "@mdx-js/loader": "^3.1.1",
        "@mdx-js/mdx": "3.1.1",
        "@mdx-js/react": "^3.1.1",
        "@next/mdx": "16.4.6",
        "@radix-ui/react-accordion": "^1.2.12",
        "@radix-ui/react-navigation-menu": "^1.2.14",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-tabs": "^1.1.13",
        "@radix-ui/react-toggle-group": "^1.2.1",
        "@repo/boli": "workspace:*",
        "@repo/brand": "workspace:*",
        "@repo/core": "workspace:*",
        "@repo/crypto": "workspace:*",
        "@repo/db": "workspace:*",
        "@repo/errors": "workspace:*",
        "@repo/legal": "workspace:*",
        "@repo/ui": "workspace:*",
        "@tailwindcss/postcss": "^4.3.5",
        "framer-motion": "^12.23.26",
        "lucide-react": "^0.562.0",
        "next": "16.4.6",
        "postcss": "^8.5.6",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-markdown": "^10.1.0",
        "remark-frontmatter": "^5.0.0",
        "remark-gfm": "^4.0.1",
        "server-only": "^0.0.1",
        "tailwindcss": "^4.3.5",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@opennextjs/cloudflare": "^1.20.18",
        "@repo/eslint-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@types/mdx": "^2.0.13",
        "@types/node": "^22.15.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^9.39.1",
        "tsx": "^4.23.15",
        "typescript": "5.9.3",
        "wrangler": "^4.166.0"
    }
}
