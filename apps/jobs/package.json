{
    "name": "jobs",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "description": "boli-jobs: the Cloudflare Worker for long jobs (Workflows) and live shared state (the RateLimiter Durable Object), called by main and admin through the JOBS service binding",
    "scripts": {
        "dev": "wrangler dev --port 3103 --inspector-port 9233",
        "check-types": "tsc --noEmit",
        "cf-typegen": "wrangler types --env-interface JobsEnvGenerated worker-configuration.d.ts"
    },
    "dependencies": {
        "@repo/boli": "workspace:*",
        "@repo/db": "workspace:*",
        "@repo/errors": "workspace:*",
        "@repo/jawaf": "workspace:*",
        "@repo/jobs": "workspace:*"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20261119.1",
        "@repo/typescript-config": "workspace:*",
        "@types/node": "^22.15.3",
        "typescript": "5.9.3",
        "wrangler": "^4.166.0"
    }
}
