{
	"name": "@repo/jawaf",
	"version": "0.0.0",
	"private": true,
	"description": "Jawaf's engine and job steps, framework-free (no next, no server-only): text, scripts, embeddings, boli-chat calls, retrieval, indexing, fact drafting, metering, site map, answers, the quality check; the jawaf_job rows, the step functions and the local / Workflow runners",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./answer": "./src/answer.ts",
		"./bots": "./src/bots.ts",
		"./crawl": "./src/crawl.ts",
		"./draft": "./src/draft.ts",
		"./embed": "./src/embed.ts",
		"./eval": "./src/eval.ts",
		"./indexer": "./src/indexer.ts",
		"./jobs": "./src/jobs/index.ts",
		"./llm": "./src/llm.ts",
		"./map": "./src/map.ts",
		"./meter": "./src/meter.ts",
		"./retrieve": "./src/retrieve.ts",
		"./script": "./src/script.ts",
		"./text": "./src/text.ts",
		"./types": "./src/types.ts"
	},
	"scripts": {
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"@repo/ai": "workspace:*",
		"@repo/billing": "workspace:*",
		"@repo/boli": "workspace:*",
		"@repo/db": "workspace:*",
		"@repo/errors": "workspace:*",
		"@repo/pdf": "workspace:*",
		"@repo/sarvamai": "workspace:*",
		"@repo/storage": "workspace:*",
		"@repo/webdata": "workspace:*"
	},
	"devDependencies": {
		"@repo/typescript-config": "workspace:*",
		"@types/node": "^22.15.3",
		"typescript": "5.9.3"
	}
}
