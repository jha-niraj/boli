{
	"name": "@repo/db",
	"version": "1.0.0",
	"description": "Shared Drizzle ORM database client for the monorepo",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./schema": "./src/schema/index.ts",
		"./client": "./src/client.ts"
	},
	"scripts": {
		"db:push": "node scripts/guard-push.mjs && dotenv -e ../../apps/main/.env.local -- drizzle-kit push",
		"db:studio": "dotenv -e ../../apps/main/.env.local -- drizzle-kit studio",
		"db:seed": "dotenv -e ../../apps/main/.env.local -- tsx src/seed.ts",
		"check-types": "tsc --noEmit",
		"sql": "dotenv -e ../../apps/main/.env.local -- node scripts/run-sql.mjs",
		"backfill:workspaces": "dotenv -e ../../apps/main/.env.local -- node scripts/backfill-workspaces.mjs",
		"jawaf:house": "dotenv -e ../../apps/admin/.env.local -- node scripts/jawaf-house.mjs",
		"jawaf:stuck-reads": "dotenv -e ../../apps/main/.env.local -- node scripts/jawaf-stuck-reads.mjs",
		"seed:testadmin": "dotenv -e ../../apps/main/.env.local -- tsx src/seed-test-admin.ts"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.2.1",
		"@repo/errors": "workspace:*",
		"drizzle-orm": "^0.45.4"
	},
	"devDependencies": {
		"@repo/crypto": "workspace:*",
		"@types/node": "^22.15.3",
		"dotenv-cli": "^11.0.0",
		"drizzle-kit": "^0.31.11",
		"tsx": "^4.23.15",
		"typescript": "5.9.3",
		"@repo/typescript-config": "workspace:*"
	}
}
