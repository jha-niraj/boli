{
	"extends": "@repo/typescript-config/react-library.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"noEmit": true,
